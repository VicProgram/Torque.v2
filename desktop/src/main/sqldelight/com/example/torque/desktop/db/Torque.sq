CREATE TABLE IF NOT EXISTS motos (
    idMoto INTEGER PRIMARY KEY AUTOINCREMENT,
    marca TEXT NOT NULL DEFAULT '',
    modelo TEXT NOT NULL DEFAULT '',
    anio INTEGER NOT NULL DEFAULT 0,
    matricula TEXT,
    color TEXT,
    cilindrada TEXT,
    caballos TEXT,
    estilo TEXT,
    kilometros INTEGER NOT NULL DEFAULT 0,
    fechaCompra TEXT,
    esPrincipal INTEGER NOT NULL DEFAULT 0,
    uriFoto TEXT,
    creadoEn TEXT,
    actualizadoEn TEXT,
    fechaItv TEXT,
    fechaSeguro TEXT,
    tipoVehiculo TEXT NOT NULL DEFAULT 'MOTO',
    tipoCarroceria TEXT,
    tipoCombustible TEXT,
    tipoTransmision TEXT,
    numeroPuertas INTEGER
);

CREATE TABLE IF NOT EXISTS mantenimientos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    idMoto INTEGER NOT NULL,
    nombreMantenimiento TEXT NOT NULL,
    fecha TEXT NOT NULL,
    kms INTEGER NOT NULL DEFAULT 0,
    intervaloKms INTEGER NOT NULL DEFAULT 0,
    precio TEXT,
    tiempo TEXT,
    notas TEXT,
    tareas TEXT,
    creadoEn TEXT,
    tipoMantenimientoId INTEGER NOT NULL DEFAULT 0,
    porcentajeVida INTEGER NOT NULL DEFAULT 100
);

CREATE TABLE IF NOT EXISTS fotos_moto (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    idMoto INTEGER NOT NULL,
    ruta TEXT NOT NULL,
    creadoEn TEXT
);

CREATE TABLE IF NOT EXISTS fotos_mantenimiento (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    idMantenimiento INTEGER NOT NULL,
    ruta TEXT NOT NULL,
    tipo TEXT NOT NULL DEFAULT 'foto',
    creadoEn TEXT
);

-- Motos
obtenerTodasMotos:
SELECT * FROM motos ORDER BY creadoEn DESC;

obtenerMotoPorId:
SELECT * FROM motos WHERE idMoto = ?;

contarMotos:
SELECT COUNT(*) FROM motos;

insertarMoto:
INSERT INTO motos(marca, modelo, anio, matricula, cilindrada, caballos, estilo, kilometros, esPrincipal, uriFoto, creadoEn, actualizadoEn)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

eliminarTodoMotos:
DELETE FROM motos;

-- Mantenimientos
obtenerMantenimientosPorMoto:
SELECT * FROM mantenimientos WHERE idMoto = ? ORDER BY fecha DESC;

insertarMantenimiento:
INSERT INTO mantenimientos(idMoto, nombreMantenimiento, fecha, kms, intervaloKms, precio, tiempo, notas, tareas, creadoEn, tipoMantenimientoId, porcentajeVida)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

eliminarTodoMantenimientos:
DELETE FROM mantenimientos;

-- Fotos moto
obtenerFotosPorMoto:
SELECT * FROM fotos_moto WHERE idMoto = ? ORDER BY creadoEn DESC;

insertarFoto:
INSERT INTO fotos_moto(idMoto, ruta, creadoEn) VALUES (?, ?, ?);

eliminarTodoFotos:
DELETE FROM fotos_moto;

-- Fotos mantenimiento
obtenerFotosPorMantenimiento:
SELECT * FROM fotos_mantenimiento WHERE idMantenimiento = ?;

insertarFotoMantenimiento:
INSERT INTO fotos_mantenimiento(idMantenimiento, ruta, tipo, creadoEn) VALUES (?, ?, ?, ?);

eliminarTodoFotosMantenimiento:
DELETE FROM fotos_mantenimiento;
