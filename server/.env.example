# Copy this file to `.env` and adjust the values before running the server.
# Environment: development | test | production.
ENVIRONMENT=development

# SQLite for local development — use postgresql://user:pass@host:5432/dbname in production.
DATABASE_URL=sqlite:///./torque.db
# REDIS_URL=redis://localhost:6379/0

# Generate strong values, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real secret. Production refuses to start with a placeholder.
SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
# Separate pepper for PIN lookup HMACs. If empty, SECRET_KEY is used.
# Set a dedicated value in production: rotating SECRET_KEY then does not
# invalidate stored PIN lookups. Rotating PIN_PEPPER itself requires resetting
# every user PIN (see docs/CHANGE_MANAGEMENT.md).
# PIN_PEPPER=replace-with-another-random-secret

ALGORITHM=HS256
JWT_ISSUER=torque-api
JWT_AUDIENCE=torque-clients
ACCESS_TOKEN_EXPIRE_MINUTES=60
PIN_TOKEN_EXPIRE_MINUTES=480

# Development only; production refuses DEBUG=true.
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# Comma-separated host header allow-list. Use explicit hosts in production.
TRUSTED_HOSTS=*
# Production requires true; terminate TLS at the proxy and forward headers.
FORCE_HTTPS=false
# Uvicorn only trusts X-Forwarded-* from these hosts. Set the reverse-proxy IP
# so rate limiting and audit logs see the real client address.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Disable interactive API docs in production if they are not needed.
ENABLE_DOCS=true

# Maximum accepted request body (bytes). Keep a matching limit at the proxy.
MAX_REQUEST_BYTES=10485760

# Brute-force controls. Use Redis/gateway for multi-worker deployments.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
