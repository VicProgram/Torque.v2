# Copy this file to `.env` and adjust the values before running the server.
# SQLite for local development — use postgresql://user:pass@host:5432/dbname in production.
DATABASE_URL=sqlite:///./torque.db
# REDIS_URL=redis://localhost:6379/0

# Generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Never commit the real secret.
SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PIN_TOKEN_EXPIRE_MINUTES=10080

# Development only; keep DEBUG=false in production.
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
