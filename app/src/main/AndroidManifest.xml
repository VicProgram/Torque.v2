<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- El backend de taller se sirve por HTTP en la red local (ver AuthManager). -->
    <application
        android:name=".TorqueApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Torque"
        android:theme="@style/Theme.TorqueLight"
        android:usesCleartextTraffic="true">

        <!-- Desactivar auto-init de Sentry (lo inicializamos manualmente en TorqueApp) -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Login -->
        <activity
            android:name=".login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.TorqueSplash" />

        <!-- Activity Principal -->
        <activity
            android:name=".menuprincipal.MenuPrincipal"
            android:exported="true"
            android:theme="@style/Theme.TorqueSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activities de Maintenance -->
        <activity android:name=".maintenance.RegistroMantenimiento" android:exported="false" />
        <activity android:name=".maintenance.FormularioMantenimiento" android:exported="false" />
        <activity android:name=".maintenance.OpcionesMantenimiento" android:exported="false" />
        <activity android:name=".maintenance.MantenimientoHistorial" android:exported="false" />
        <activity android:name=".maintenance.PlanMantenimiento" android:exported="false" />

        <!-- Activities de Garage -->
        <activity android:name=".garage.MotoDetalle" android:exported="false" />
        <activity android:name=".garage.AnadirMotoActivity" android:exported="false" />
        <activity android:name=".garage.ListaGaraje" android:exported="false" />

        <!-- Perfil y Ajustes -->
        <activity android:name=".perfil.PerfilActivity" android:exported="false" />
        <activity android:name=".ajustes.AjustesActivity" android:exported="false" />

    </application>
</manifest>